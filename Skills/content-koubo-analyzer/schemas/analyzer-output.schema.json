              "minLength": 1
            },
            "target_audience": {
              "type": "string",
              "minLength": 1
            },
            "core_promise": {
              "type": "string",
              "minLength": 1
            },
            "borrowed_value": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "method_asset_usage": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
