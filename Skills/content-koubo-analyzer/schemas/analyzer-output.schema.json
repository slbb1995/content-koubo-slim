    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis_version",
        "reference_analyses",
        "selected_method_assets",
        "fused_direction",
        "content_goal",
        "speaker_mode",
        "writer_mode",
        "writer_mode_reason",
        "secondary_tactics",
