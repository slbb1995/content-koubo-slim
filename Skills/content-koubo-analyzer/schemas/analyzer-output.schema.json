          "type": "array",
          "minItems": 0,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reference_id",
              "content_value",
              "hook_mechanism",
              "structure_mechanism",
              "transferable_points",
              "prohibited_transfers"
            ],
            "properties": {
              "reference_id": {
                "type": "string",
                "pattern": "^REF-[0-9]{3}$"
              },
              "content_value": {
                "type": "string",
                "minLength": 1
              },
              "hook_mechanism": {
                "type": "string",
                "minLength": 1
              },
              "structure_mechanism": {
                "type": "string",
                "minLength": 1
              },
              "transferable_points": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
