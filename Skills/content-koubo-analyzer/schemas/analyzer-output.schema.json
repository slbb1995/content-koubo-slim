              "asset_role": {
                "enum": [
                  "peer_content_asset",
                  "oral_method_asset"
                ]
              },
              "relative_path": {
                "type": "string",
                "minLength": 1
              },
              "page_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "usage": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "fused_direction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target_audience",
            "core_promise",
            "external_reference_value",
            "structure_plan",
            "conflicts",
            "user_boundaries",
