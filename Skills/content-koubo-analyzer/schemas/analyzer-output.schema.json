              },
              "prohibited_transfers": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "selected_method_assets": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "asset_id",
              "asset_role",
              "relative_path",
              "page_sha256",
              "usage",
              "reason"
            ],
