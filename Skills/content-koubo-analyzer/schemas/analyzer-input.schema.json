{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-koubo-slim.invalid/schemas/analyzer-input.schema.json",
  "title": "Content 口播 Slim Analyzer Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analysis_version",
    "topic_original",
    "topic_normalized",
    "topic_normalized_source",
    "client_id",
    "speaker_mode",
    "user_thoughts",
    "must_keep",
    "must_avoid",
    "references",
    "method_candidates",
    "revision_request"
  ],
  "properties": {
    "analysis_version": {"const": "slim-1.0"},
    "topic_original": {"type": "string", "minLength": 1},
    "topic_normalized": {"type": "string", "minLength": 1},
    "topic_normalized_source": {"const": "system_generated"},
    "client_id": {"type": "string", "minLength": 1},
    "speaker_mode": {"enum": ["personal_ip", "company_brand", "neutral"]},
    "user_thoughts": {"type": ["string", "null"]},
    "must_keep": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "must_avoid": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reference_id", "title", "content", "source_boundary"],
        "properties": {
          "reference_id": {"type": "string", "pattern": "^REF-[0-9]{3}$"},
          "title": {"type": "string", "minLength": 1},
          "content": {"type": "string", "minLength": 1},
          "source_boundary": {"type": "string", "minLength": 1}
        }
      }
    },
    "method_candidates": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "asset_role",
          "relative_path",
          "page_sha256",
          "audience_scope",
          "excerpt",
          "relevance_evidence"
        ],
        "properties": {
          "asset_id": {"type": "string", "minLength": 1},
          "asset_role": {"enum": ["peer_content_asset", "oral_method_asset"]},
          "relative_path": {"type": "string", "minLength": 1},
          "page_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "audience_scope": {"enum": ["consumer", "internal_sales_training", "both"]},
          "excerpt": {"type": "string", "minLength": 1},
          "relevance_evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "revision_request": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["base_direction_version", "feedback"],
          "properties": {
            "base_direction_version": {"type": "integer", "minimum": 1},
            "feedback": {"type": "string", "minLength": 1}
          }
        }
      ]
    }
  }
}
