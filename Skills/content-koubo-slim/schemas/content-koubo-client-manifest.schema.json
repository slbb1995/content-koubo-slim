{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-koubo-slim.invalid/schemas/content-koubo-client-manifest.schema.json",
  "title": "Content 口播 Slim Client Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "client_id",
    "asset_roots",
    "default_speaker_mode",
    "allowed_speaker_modes",
    "profile_policy",
    "default_platform",
    "output_template"
  ],
  "properties": {
    "contract_version": {
      "const": "2.0"
    },
    "client_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "asset_roots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["knowledge", "method", "profile", "output"],
      "properties": {
        "knowledge": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "profile": {"type": "string", "minLength": 1},
        "output": {"type": "string", "minLength": 1}
      }
    },
    "default_speaker_mode": {
      "enum": ["personal_ip", "company_brand", "neutral"]
    },
    "allowed_speaker_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["personal_ip", "company_brand", "neutral"]
      }
    },
    "profile_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_when", "selector"],
      "properties": {
        "required_when": {
          "const": ["personal_ip"]
        },
        "selector": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "is_primary"],
          "properties": {
            "status": {"const": "active"},
            "is_primary": {"const": true}
          }
        }
      }
    },
    "default_platform": {
      "type": "string",
      "minLength": 1
    },
    "output_template": {
      "type": "string",
      "minLength": 1
    }
  }
}
